{
  "name": "planer",
  "private": true,
  "version": "1.0.0",
  "main": "./electron/main.js",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && node electron/run-dev.cjs\"",
    "electron:build": "npm run build && electron-builder",
    "test": "node --test tests/planner-reads.test.mjs tests/google-auth.test.cjs tests/account-isolation.test.mjs tests/activity-history.test.mjs tests/schedule-time.test.mjs tests/control-time.test.mjs tests/control-colors.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-planer-security \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "firebase-tools": "^15.32.0",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.planer.app",
    "productName": "Planer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
