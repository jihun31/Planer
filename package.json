{
  "name": "planer",
  "private": true,
  "version": "1.2.0",
  "main": "./electron/main.js",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build && node scripts/write-build-info.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && node electron/run-dev.cjs\"",
    "electron:build": "npm run build && electron-builder --publish never",
    "app:local": "npm run build && electron-builder --win --dir --publish never",
    "install:local": "node scripts/install-local.mjs",
    "test": "node scripts/test-files.mjs",
    "test:dom": "node scripts/test-files.mjs --dom",
    "test:affected": "node scripts/affected-tests.mjs --run",
    "check:version": "node scripts/check-version.mjs",
    "version:app": "node scripts/app-version.mjs",
    "test:plans": "node --test tests/day-plans.test.mjs",
    "test:plans:ui": "node tests/day-plans-dom.test.cjs",
    "test:planner:ui": "node tests/planner-integration-dom.test.cjs",
    "test:activities:ui": "node tests/activity-manager-dom.test.cjs",
    "test:bot": "firebase emulators:exec --only firestore --project demo-planer-security \"python -m pytest bot -q\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-planer-security \"node scripts/test-files.mjs --rules\"",
    "test:notes:dom": "node tests/note-drag-dom.test.cjs",
    "test:notes:checklist": "node tests/note-checklist-dom.test.cjs",
    "test:notes:lists": "node tests/note-lists-dom.test.cjs",
    "test:notes:workspace": "node tests/note-workspace-dom.test.cjs",
    "test:notes:images": "node tests/note-images-dom.test.cjs",
    "test:memo-todo": "node tests/memo-todo-dom.test.cjs",
    "test:habits:ui": "node tests/habits-dom.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "firebase": "^12.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "firebase-tools": "^15.32.0",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.planer.app",
    "productName": "Planer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Planner",
      "artifactName": "Planner-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jihun31",
        "repo": "Planer"
      }
    ]
  }
}
